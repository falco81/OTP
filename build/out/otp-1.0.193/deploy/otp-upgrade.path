# /etc/systemd/system/otp-upgrade.path (1.0.37)
#
# Watches for a new version asked for on the pages: the otp service lays a
# signed package and request.json down in /var/lib/otp/upgrade/, and this
# starts otp-upgrade.service, which checks the package as root and runs its
# install.sh --upgrade. Nothing else can be asked for this way.
[Unit]
Description=otp - a new version asked for on the pages

[Path]
PathExists=/var/lib/otp/upgrade/request.json
Unit=otp-upgrade.service

[Install]
WantedBy=multi-user.target
