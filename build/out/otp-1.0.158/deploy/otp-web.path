[Unit]
Description=otp - TLS, the web address, the firewall, the network, the time, the console at login or PostgreSQL's log, asked for on the pages

[Path]
PathExists=/var/lib/otp/web/request.json
PathExists=/var/lib/otp/web/pglog.ask
PathExists=/var/lib/otp/web/pgtls.ask
PathExists=/var/lib/otp/web/fw.ask
PathExists=/var/lib/otp/web/net.ask
PathExists=/var/lib/otp/web/ntp.ask
PathExists=/var/lib/otp/web/console.ask
PathExists=/var/lib/otp/web/sshkeys.ask
PathExists=/var/lib/otp/web/osup.ask
Unit=otp-web.service

[Install]
WantedBy=multi-user.target
