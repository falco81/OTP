#!/bin/sh
# otp-vip-check - what keepalived asks about the cluster's web address (otp 1.0.47).
#   ok       may this node hold it? otp writes /run/otp/vip-state every few seconds;
#            stale (otp not running), missing or "fail ..." (maintenance, an upgrade)
#            is no.
#   prefer   is this the node it is meant to be on (moved on the pages)?
#   notify   keepalived saying what this node now is: MASTER, BACKUP or FAULT.
# Run by keepalived as the otp account (script_user otp); root's own file, so
# keepalived's script security takes it.
f=/run/otp/vip-state
case "$1" in
  ok)
    [ -f "$f" ] || exit 1
    now=$(date +%s); at=$(stat -c %Y "$f" 2>/dev/null) || exit 1
    [ $((now - at)) -le 20 ] || exit 1
    head -c 2 "$f" | grep -q '^ok' ;;
  prefer)
    [ -f "$f" ] || exit 1
    grep -q '^ok prefer' "$f" ;;
  notify)
    # keepalived adds: TYPE NAME STATE PRIORITY
    [ -d /run/otp ] && printf '%s %s\n' "$4" "$(date +%s)" > /run/otp/vip-role 2>/dev/null
    exit 0 ;;
  *) exit 2 ;;
esac
