# /etc/logrotate.d/otp
#
# The daemon's own log, and the two files it writes for isemon (the token
# checks and the RADIUS packets, one to a line). The daemon notices a file
# that has been renamed and opens a new one by itself; the reload makes it
# reopen its own log too.
/var/log/otp/*.log {
    daily
    maxsize 200M
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    dateext
    dateformat -%Y%m%d-%s
    su otp otp
    create 0640 otp otp
    postrotate
        # As otp, which may signal its own daemon (1.0.94) - systemctl reload
        # was refused to it; the daemon also notices a new file by itself.
        p=$(/usr/bin/systemctl show -p MainPID --value otp.service 2>/dev/null); [ -n "$p" ] && [ "$p" != 0 ] && kill -HUP "$p" 2>/dev/null || true
    endscript
}
