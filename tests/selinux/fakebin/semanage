#!/bin/bash
. "$(dirname "$0")/_common"
touch "$S/ports"
if [ "$1 $2" = "port -l" ]; then printf 'SELinux Port Type              Proto    Port Number\n\n'; cat "$S/ports"; exit 0; fi
if [ "$1 $2" = "port -a" ]; then t=$4; p=$6; n=$7
  grep -q " $p .*\b$n\b" "$S/ports" && { echo "ValueError: Port $p/$n already defined" >&2; exit 1; }
  printf '%-30s %-8s %s\n' "$t" "$p" "$n" >> "$S/ports"; exit 0; fi
if [ "$1 $2" = "port -m" ]; then t=$4; p=$6; n=$7; printf '%-30s %-8s %s\n' "$t" "$p" "$n" >> "$S/ports"; exit 0; fi
exit 1
